/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.openstreetmap.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://ipapi.co https://api.ip.sb https://ipinfo.io https://www.cloudflare.com https://1.1.1.1 https://www.baidu.com https://www.google.com https://github.com https://res.wx.qq.com https://i0.hdslb.com; frame-src https://www.openstreetmap.org; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# 静态资源长缓存
/*.css
  Cache-Control: public, max-age=86400, must-revalidate

/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

# robots 和 sitemap 不缓存
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
